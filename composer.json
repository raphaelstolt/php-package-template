{
    "name": "vendor-name/package-name",
    "description": "Package description.",
    "keywords": ["keyword", "keyword-n"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "VendorName\\PackageName\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VendorName\\PackageName\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Author Name",
            "email": "author@example.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "carthage-software/mago": true
        }
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "carthage-software/mago": "^1.49",
        "myopensoft/php-version-bumper": "^1.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.3",
        "ramsey/conventional-commits": "^1.7",
        "stolt/lean-package-validator": "^6.0",
        "stolt/version-aligner": "^1.0"
    },
    "suggest": {
        "stolt/php-package-ai-skill": "Enables the acceleration of package development by leveraging AI capabilities."
    },
    "scripts": {
        "test": "phpunit",
        "cs-lint": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": "mago format",
        "validate-gitattributes": "./vendor/bin/lean-package-validator validate",
        "validate-package": "composer validate --strict",
        "version-check": "version-aligner check",
        "pre-commit-check": [
            "@validate-gitattributes",
            "@version-check",
            "@cs-lint",
            "@test"
        ]
    },
    "extra": {
        "ramsey/conventional-commits": {
            "configFile": "./conventional-commits.json"
        }
    }
}
